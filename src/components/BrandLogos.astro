---
/** Logos de Grupo Garden y de marcas del grupo que operan con el sistema. */
import { GARDEN_BRANDS, GARDEN_LOGOS } from '../lib/garden';

interface Props {
  caption?: string;
}
const { caption = 'Grupo Garden y algunas de las marcas que operan con el sistema' } = Astro.props;
---

<figure class="brands">
  <figcaption class="small muted">{caption}</figcaption>
  <ul class="logo-row">
    {GARDEN_LOGOS.map((l) => (
      <li class="logo-tile">
        <img src={l.src} alt={l.name} width={l.width} height={l.height} loading="lazy" decoding="async" />
      </li>
    ))}
  </ul>
  <p class="brand-list">Marcas del grupo en el sistema: {GARDEN_BRANDS.join(' · ')}</p>
</figure>

<style>
  .brands {
    margin: 0;
  }
  .brands figcaption {
    margin-bottom: 14px;
  }
  .brand-list {
    margin: 16px 0 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--pizarra);
  }
  :global(.sec-dark) .brands figcaption,
  :global(.sec-dark) .brand-list {
    color: var(--capa-2-noche);
  }
</style>
