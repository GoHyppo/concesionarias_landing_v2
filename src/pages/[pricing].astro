---
/**
 * /precios/ · head term: "precios de ConcesionarIA" / "precio de un software
 * para concesionarias".
 *
 * Ruta dinámica a propósito: el interruptor es PRICING_PUBLISHED
 * (src/lib/site.ts). Con false, getStaticPaths devuelve cero rutas y la página
 * NO se construye (ni sitemap, ni llms.txt, ni links). Hoy está en true.
 *
 * Todo lo que muestra sale de src/lib/pricing.ts, que es la tabla de
 * content.py tal cual. El SoftwareApplication arma un Offer por plan desde el
 * mismo arreglo, así el schema dice exactamente lo que dice la tabla visible.
 */
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import {
  breadcrumbListSchema,
  faqPageSchema,
  softwareApplicationSchema,
  type BreadcrumbItem,
  type FaqItem,
} from '../lib/seo';
import { PLANS, PRICE_ROWS, EARLY_ADOPTER, PRODUCT_PARTS, monthlyLabel } from '../lib/pricing';
import { PRICING_PUBLISHED, BOOKING_ANCHOR } from '../lib/site';

export function getStaticPaths() {
  return PRICING_PUBLISHED ? [{ params: { pricing: 'precios' } }] : [];
}

const title = 'Precios de ConcesionarIA: planes Gold, Platinum y Enterprise';
const description =
  'Precios de ConcesionarIA en USD: Gold 750, Platinum 2.750 y Enterprise desde 5.000 por mes, con conversaciones y vendedores incluidos e implementación única.';

const crumbs: BreadcrumbItem[] = [
  { name: 'Inicio', path: '/' },
  { name: 'Precios', path: '/precios/' },
];

const [gold, platinum, enterprise] = PLANS;
const faq: FaqItem[] = [
  {
    q: '¿Cuánto cuesta ConcesionarIA por mes?',
    a: `El abono mensual es de USD ${gold.price} en el plan Gold, USD ${platinum.price} en Platinum y desde USD ${enterprise.price} en Enterprise. A eso se suma una implementación que se paga una sola vez.`,
  },
  {
    q: '¿Qué pasa si supero las conversaciones incluidas?',
    a: `Gold y Platinum incluyen ${gold.conversations} conversaciones y Enterprise ${enterprise.conversations}. Cada conversación adicional cuesta USD ${gold.extraConversation} en Gold, USD ${platinum.extraConversation} en Platinum y USD ${enterprise.extraConversation} en Enterprise.`,
  },
  {
    q: '¿Puedo sumar vendedores a mi plan?',
    a: `Sí. Gold incluye ${gold.seats} licencias de vendedor, Platinum ${platinum.seats} y Enterprise ${enterprise.seats}. Cada licencia adicional cuesta USD ${gold.extraSeat} por mes en Gold, USD ${platinum.extraSeat} en Platinum y de USD ${enterprise.extraSeat} en Enterprise.`,
  },
  {
    q: '¿Cuánto cuesta la implementación?',
    a: `Es un pago único: USD ${gold.setup} en Gold, USD ${platinum.setup} en Platinum y a medida en Enterprise. Las primeras 10 concesionarias de Argentina tienen 50% de descuento en la implementación.`,
  },
];

const schemas = [
  breadcrumbListSchema(crumbs),
  softwareApplicationSchema({
    description:
      'IA para concesionarias de autos: agente de IA en WhatsApp, motor de automatización, dashboard de gestión e integraciones con el CRM y el ERP de la concesionaria.',
    offers: PLANS.map((p) => ({
      name: `Plan ${p.name}`,
      price: p.priceValue,
      isFrom: p.isFrom,
      description: `Abono mensual ${monthlyLabel(p)}. Incluye ${p.conversations} conversaciones y ${p.seats} licencias de vendedor. Implementación: ${p.setup === 'A medida' ? 'a medida' : `USD ${p.setup}`}.`,
    })),
  }),
  faqPageSchema(faq),
];
---

<Layout title={title} description={description} jsonLd={schemas}>
  <section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <p class="kicker">Precios</p>
      <h1>Precios de ConcesionarIA</h1>
      <p class="lead">
        Tres planes con abono mensual en USD. Cambian las conversaciones y las licencias de vendedor incluidas, el
        precio de lo adicional y la implementación, que se paga una sola vez.
      </p>
      <p class="early">{EARLY_ADOPTER}</p>
    </div>
  </section>

  <section class="sec" aria-labelledby="planes-h">
    <div class="wrap">
      <h2 id="planes-h" class="visually-hidden">Planes</h2>
      <div class="plans">
        {PLANS.map((p) => (
          <article class:list={['card', 'plan', { 'plan-hi': p.highlight }]} data-plan={p.id}>
            <h3>Plan {p.name}</h3>
            <p class="price">
              {p.isFrom && <span class="muted">desde </span>}
              <span class="num">USD {p.price}</span>
              <span class="muted"> / mes</span>
            </p>
            <dl class="meta">
              <div><dt>Conversaciones incluidas</dt><dd>{p.conversations}</dd></div>
              <div><dt>Conversación adicional</dt><dd>USD {p.extraConversation}</dd></div>
              <div><dt>Licencias de vendedor incluidas</dt><dd>{p.seats}</dd></div>
              <div><dt>Licencia adicional</dt><dd>USD {p.extraSeat} / mes</dd></div>
              <div><dt>Implementación, única vez</dt><dd>{p.setup === 'A medida' ? 'A medida' : `USD ${p.setup}`}</dd></div>
            </dl>
            <a class:list={['btn', p.highlight ? 'btn-primary' : 'btn-ghost']} href={BOOKING_ANCHOR} data-cta={`precios-${p.id}`}>
              Hablar sobre {p.name} <Icon name="arrow" />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec-alt" aria-labelledby="tabla-h">
    <div class="wrap">
      <h2 id="tabla-h">Tabla de precios</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Concepto</span></th>
              {PLANS.map((p) => <th scope="col">{p.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {PRICE_ROWS.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {PLANS.map((p) => <td>{row.value(p)}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted note">{EARLY_ADOPTER} Precios en dólares estadounidenses; el alcance y las condiciones finales quedan en la propuesta firmada.</p>
    </div>
  </section>

  <section class="sec" aria-labelledby="incluye-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">El producto</p>
        <h2 id="incluye-h">Qué es ConcesionarIA</h2>
        <p class="lead">
          Ordena la venta por WhatsApp: un agente de IA atiende al lead en segundos, lo califica, hace el seguimiento y
          registra cada conversación, y un dashboard le da al dueño visibilidad del embudo, del clic a la factura.
        </p>
      </div>
      <div class="grid grid-4">
        {PRODUCT_PARTS.map((part) => (
          <div class="card">
            <h3>{part.title}</h3>
            <p>{part.text}</p>
          </div>
        ))}
      </div>
      <p class="more muted">
        Más detalle en <a href="/producto/">cómo funciona el producto</a> y en <a href="/integraciones/">integraciones</a>.
      </p>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="wrap">
      <FaqSection items={faq} title="Preguntas sobre precios" />
      <p class="muted more">
        ¿Quieres ver si se paga en tu concesionaria? Usa la <a href="/calculadora-roi/">calculadora de ROI</a>.
      </p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <CtaBand
        placement="precios-cta"
        title="Elijamos el plan con tus números"
        text="En la demo revisamos tu volumen de conversaciones, tu equipo de ventas y tus integraciones, y te enviamos la propuesta."
      />
    </div>
  </section>
</Layout>

<style>
  .early {
    display: inline-block;
    margin-top: 12px;
    padding: 8px 14px;
    border-radius: var(--radius);
    background: var(--blanco);
    border: 1px solid var(--vidrio);
    color: var(--noche);
    font-weight: 500;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .plans {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 1000px) {
    .plans {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .plan {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 28px;
  }
  .plan h3 {
    font-size: 1.375rem;
  }
  .plan-hi {
    background: var(--noche);
    border-color: var(--noche);
    color: var(--blanco);
  }
  .plan-hi h3,
  .plan-hi .num,
  .plan-hi .meta dd {
    color: var(--blanco);
  }
  .plan-hi .muted,
  .plan-hi .meta dt {
    color: var(--capa-2-noche);
  }
  .plan-hi .meta div {
    border-bottom-color: var(--line-dark);
  }
  .plan-hi .btn-primary {
    background: var(--blanco);
    color: var(--noche);
  }
  .plan-hi :focus-visible {
    outline-color: var(--blanco);
  }
  .plan .btn {
    margin-top: auto;
  }
  .price {
    margin: 4px 0 12px;
  }
  .price .num {
    font-size: clamp(1.9rem, 2.6vw, 2.4rem);
  }
  .meta {
    margin: 0 0 20px;
  }
  .meta div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--border-soft);
    font-size: 0.95rem;
  }
  .meta dt {
    color: var(--text-2);
  }
  .meta dd {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
    text-align: right;
  }
  th[scope='row'] {
    background: transparent;
    color: var(--noche);
    font-family: var(--font);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  .note {
    margin-top: 16px;
    max-width: 80ch;
  }
  .more {
    margin-top: 24px;
  }
</style>
