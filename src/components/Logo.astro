---
/**
 * Isotipo (la "C" de bloques, igual que favicon.svg y el logo de la v1) +
 * wordmark "ConcesionarIA" en Space Grotesk. El "IA" va en violeta claro para
 * pasar contraste sobre el fondo oscuro.
 */
interface Props {
  size?: number;
  showByline?: boolean;
}
const { size = 34, showByline = true } = Astro.props;
---

<span class="logo">
  <svg class="logo-mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <rect width="64" height="64" rx="14" fill="#6D2EFF"></rect>
    <rect x="28" y="16" width="18" height="10" rx="2" fill="#fff"></rect>
    <rect x="16" y="24" width="14" height="18" rx="2" fill="#fff"></rect>
    <rect x="28" y="38" width="18" height="10" rx="2" fill="#fff"></rect>
  </svg>
  <span class="logo-text">
    <span class="logo-name">Concesionar<span class="logo-ia">IA</span></span>
    {showByline && <span class="logo-by">por Hyppo</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .logo-mark {
    flex: none;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .logo-name {
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .logo-ia {
    color: var(--violet-text);
  }
  .logo-by {
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
</style>
