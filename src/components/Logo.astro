---
/**
 * Logo de ConcesionarIA (marca "Capas", 2026-11-11): símbolo de tres barras
 * desfasadas + "ConcesionarIA" en trazos (Onest 600, del kit de marca). Nunca
 * se redibuja con la fuente. "IA" va en el tinte de la segunda capa a propósito,
 * para que la I no se lea como l.
 * - variant "noche": sobre escarcha o blanco (default).
 * - variant "blanco": sobre noche.
 */
interface Props {
  variant?: 'noche' | 'blanco';
  /** Alto en px; el ancho sale de la proporción del logo. */
  height?: number;
}
const { variant = 'noche', height = 26 } = Astro.props;
const width = Math.round((height * 7678.9) / 834.3);
