---
/**
 * Navegación principal. El menú mobile es un <details>: abre y cierra sin
 * JavaScript, y sus links son <a href> reales (rastreables).
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, BOOKING_ANCHOR, CTA_DEMO_LABEL } from '../lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="nav" id="top">
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <div class="wrap nav-row">
    <a href="/" class="nav-brand" aria-label="ConcesionarIA, inicio">
      <Logo height={26} />
    </a>

    <nav class="nav-links" aria-label="Principal">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="btn btn-primary nav-cta" href={BOOKING_ANCHOR} data-cta="nav">{CTA_DEMO_LABEL}</a>

    <details class="nav-mobile">
      <summary aria-label="Abrir menú">
        <Icon name="menu" class="nav-open" />
        <Icon name="close" class="nav-close" />
      </summary>
      <div class="nav-panel">
        <nav aria-label="Principal (mobile)">
          <ul>
            {NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
            <li><a href="/demo/">Demo en vivo</a></li>
            <li><a href="/calculadora-roi/">Calculadora de ROI</a></li>
          </ul>
        </nav>
        <a class="btn btn-primary" href={BOOKING_ANCHOR} data-cta="nav-mobile">{CTA_DEMO_LABEL}</a>
      </div>
    </details>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 1000;
    height: var(--nav-h);
    background: rgba(233, 237, 241, 0.86);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--vidrio);
  }
  .nav-row {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .nav-brand {
    text-decoration: none;
    margin-right: auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @media (max-width: 420px) {
    .nav-brand :global(.logo) {
      height: 21px;
      width: auto;
    }
  }
  .nav-links {
    display: none;
  }
  .nav-links ul {
    display: flex;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    color: var(--pizarra);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    padding: 6px 0;
    border-bottom: 2px solid transparent;
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--noche);
    border-bottom-color: var(--noche);
  }
  .nav-cta {
    display: none;
    min-height: 44px;
    padding: 10px 18px;
    font-size: 0.95rem;
  }
  .nav-mobile {
    position: static;
  }
  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--vidrio);
    border-radius: var(--radius);
    background: var(--blanco);
    color: var(--noche);
  }
  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }
  /* Los íconos vienen de Icon.astro: el scope de este componente no les llega,
     por eso van con :global(). */
  .nav-mobile :global(.nav-close) {
    display: none;
  }
  .nav-mobile[open] :global(.nav-close) {
    display: block;
  }
  .nav-mobile[open] :global(.nav-open) {
    display: none;
  }
  .nav-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--nav-h);
    background: var(--escarcha);
    border-bottom: 1px solid var(--vidrio);
    padding: 12px var(--gutter) 24px;
    max-height: calc(100vh - var(--nav-h));
    overflow-y: auto;
  }
  .nav-panel ul {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
  }
  .nav-panel a:not(.btn) {
    display: block;
    padding: 14px 4px;
    color: var(--noche);
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 500;
    border-bottom: 1px solid var(--vidrio);
  }
  .nav-panel a[aria-current='page'] {
    box-shadow: inset 3px 0 0 var(--noche);
    padding-left: 14px;
  }
  .nav-panel .btn {
    width: 100%;
  }
  @media (min-width: 1040px) {
    .nav-links,
    .nav-cta {
      display: flex;
    }
    .nav-mobile {
      display: none;
    }
  }
</style>
