---
/**
 * Banda de prueba: las métricas públicas del caso Grupo Garden, SIEMPRE con la
 * atribución y el link a la fuente. Es la única prueba numérica del sitio.
 */
import { GARDEN_METRICS, GARDEN_SOURCE } from '../lib/garden';

interface Props {
  title?: string;
  /** Cuántas métricas mostrar (en orden). */
  limit?: number;
  headingLevel?: 'h2' | 'h3';
  showCaseLink?: boolean;
}
const {
  title = 'Lo que cambió en Grupo Garden',
  limit = 6,
  headingLevel = 'h2',
  showCaseLink = true,
} = Astro.props;
const Heading = headingLevel;
const items = GARDEN_METRICS.slice(0, limit);
---

<div class="proof">
  <div class="proof-head">
    <p class="kicker">Caso Grupo Garden · Paraguay</p>
    <Heading class="proof-title">{title}</Heading>
    <p class="muted small">
      Resultados publicados en el caso de Grupo Garden, el mayor retailer de vehículos de Paraguay.
      Fuente: <a href={GARDEN_SOURCE}>hyppo.io/casos/garden</a>.
    </p>
  </div>
  <ul class="proof-grid">
    {items.map((m) => (
      <li class="proof-item">
        <span class="num">{m.value}</span>
        <span class="proof-label">{m.label}</span>
        <span class="proof-text">{m.text}</span>
      </li>
    ))}
  </ul>
  {showCaseLink && (
    <p class="proof-link"><a href="/casos/grupo-garden/">Leer cómo se implementó en Grupo Garden</a></p>
  )}
</div>

<style>
  /* Funciona sobre fondo claro y dentro de una banda noche (.sec-dark). */
  .proof-head {
    max-width: 760px;
    margin-bottom: 32px;
  }
  .proof-title {
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
  }
  .proof-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .proof-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .proof-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .proof-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border: 1px solid var(--vidrio);
    border-radius: 16px;
    background: var(--blanco);
  }
  .proof-label {
    font-family: var(--mono);
    color: var(--pizarra);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .proof-text {
    color: var(--pizarra);
    font-size: 0.95rem;
  }
  .proof-link {
    margin-top: 24px;
    font-weight: 600;
  }
  :global(.sec-dark) .proof-item {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--line-dark);
  }
  :global(.sec-dark) .proof-label,
  :global(.sec-dark) .proof-text {
    color: var(--capa-2-noche);
  }
</style>
