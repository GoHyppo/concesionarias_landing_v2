---
/**
 * FAQ visible. La página que lo usa emite faqPageSchema() con EXACTAMENTE estos
 * items: el schema tiene que decir lo mismo que lee la persona.
 */
import type { FaqItem } from '../lib/seo';

interface Props {
  items: FaqItem[];
  title?: string;
}
const { items, title = 'Preguntas frecuentes' } = Astro.props;
---

<div class="faq">
  <h2>{title}</h2>
  <div class="faq-list">
    {items.map((item) => (
      <div class="faq-item">
        <h3>{item.q}</h3>
        <p>{item.a}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .faq-list {
    display: grid;
    border-top: 1px solid var(--vidrio);
  }
  .faq-item {
    display: grid;
    gap: 8px 40px;
    padding: 22px 0;
    border-bottom: 1px solid var(--vidrio);
  }
  @media (min-width: 900px) {
    .faq-item {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
  .faq-item h3 {
    font-size: 1.125rem;
    line-height: 1.4;
    margin: 0;
  }
  .faq-item p {
    color: var(--pizarra);
    margin: 0;
    max-width: 70ch;
  }
</style>
