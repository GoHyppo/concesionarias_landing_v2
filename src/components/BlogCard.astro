---
/** Card de un post. El nivel del título viene por prop para no romper el outline. */
import { Image } from 'astro:assets';
import type { Post } from '../lib/blog';
import { formatDate, isoDate, postPath } from '../lib/blog';
import { getCategory } from '../lib/categories';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const cat = getCategory(post.data.category);
---

<article class="bcard">
  {post.data.image && (
    <a href={postPath(post.slug)} class="bcard-img" tabindex="-1" aria-hidden="true">
      <Image src={post.data.image} alt="" aria-hidden="true" widths={[480, 720]} sizes="(min-width: 1000px) 360px, 100vw" loading="lazy" decoding="async" />
    </a>
  )}
  <div class="bcard-body">
    <p class="bcard-cat"><a href={`/blog/tema/${cat.id}/`}>{cat.name}</a></p>
    <Heading class="bcard-title"><a href={postPath(post.slug)}>{post.data.title}</a></Heading>
    <p class="bcard-desc">{post.data.description}</p>
    <p class="bcard-date small muted"><time datetime={isoDate(post.data.publishedAt)}>{formatDate(post.data.publishedAt)}</time></p>
  </div>
</article>

<style>
  .bcard {
    display: flex;
    flex-direction: column;
    background: var(--blanco);
    border: 1px solid var(--vidrio);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s var(--ease);
  }
  .bcard:hover {
    border-color: var(--noche);
  }
  .bcard-img {
    display: block;
    background: var(--escarcha);
    border-bottom: 1px solid var(--vidrio);
  }
  .bcard-img img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .bcard-body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .bcard-cat {
    margin: 0 0 10px;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .bcard-cat a {
    color: var(--pizarra);
    text-decoration: none;
  }
  .bcard-cat a:hover {
    color: var(--noche);
  }
  .bcard-title {
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .bcard-title a {
    color: var(--noche);
    text-decoration: none;
  }
  .bcard-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--capa-2);
  }
  .bcard-desc {
    color: var(--pizarra);
    font-size: 0.95rem;
  }
  .bcard-date {
    margin: auto 0 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
</style>
